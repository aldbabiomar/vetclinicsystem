# Local config / secrets — never committed
.env
.env.audit_backup_check

# Python
__pycache__/
*.pyc
venv/
.venv/

# App-generated, machine-local. uploads/ is the important one: it holds
# patient X-rays, bloodwork and test results, and attachments.py puts
# UPLOAD_ROOT inside this directory whenever VETCLINICSYSTEM_DATA_DIR is
# unset — which is the case for a dev clone. Without this line a `git add -A`
# in a clone that has been run locally commits clinical files to the repo.
logs/
uploads/
!uploads/.gitkeep
*.log

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Local editor/session state
.claude/

# The versioned-release layout (setup.py --enable-updates) lives OUTSIDE
# this folder as siblings (../vetclinicsystem-data, ../vetclinicsystem-releases),
# so there's nothing of theirs to ignore here — but if either ever ends up
# nested under this repo by mistake, never track it.
/vetclinicsystem-data/
/vetclinicsystem-releases/

# The two predecessor apps (VetClinicSystem IQ and JO), kept as read-only
# reference clones while their features are ported into this one codebase.
# They are separate git repositories and must never be tracked here.
# Removed once the port is complete — see docs/plans/UNIFIED_CODEBASE_PLAN.md.
webapps/

.coverage
last_restore.json
.pytest_cache/

# Regenerated by `pybabel extract` on demand; the .po (and its compiled .mo)
# are the sources of truth. Committing the .pot only creates diff noise every
# time a string moves line.
messages.pot

# simulation run output, regenerated on every run
scripts/findings_*.json

# scripts/prove_guards.py, only while a mutation is in place
.prove_guards_backup.json
# the simulation sweeps write their findings here on every run
scripts/findings_*.json

# Vendor signing keys never live in the repository (vcs/licensing).
*.pem
vendor-keys/
# A development checkout keeps its license key here (vcs/licensing/state.py).
/license/
# A development checkout keeps its GitHub access token here (vcs/ops/updater.py).
/github_token
/github_token.tmp
