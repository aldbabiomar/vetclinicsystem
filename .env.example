# Copy this file to .env — setup.py does this for you automatically and
# fills in a random SECRET_KEY. You normally don't need to edit this by hand.

DATABASE_URL=postgresql://vetclinicsystem:vetclinicsystem_local_password@127.0.0.1:5432/vetclinicsystem

# The database's host port is the one in DATABASE_URL above: setup.py uses
# 5432 unless something on this computer already has it (another program, or
# another container even while it is stopped), and then the next free one.
# The port INSIDE the container is always 5432. To choose it yourself, set
# POSTGRES_HOST_PORT before the first setup, or change DATABASE_URL here.
# POSTGRES_HOST_PORT=5433
POSTGRES_PASSWORD=vetclinicsystem_local_password
SECRET_KEY=change-me

# Which Postgres container to run pg_dump against for nightly backups
# (matches docker-compose.yml's container_name). Only used if a local
# pg_dump binary isn't found on this machine.
VETCLINICSYSTEM_PG_CONTAINER=vetclinicsystem_postgres

# --- In-app updates (Settings -> Updates) ---
# The GitHub repo this app checks for tagged Releases. Never a literal
# string anywhere in code — see updater.py and
# CLAUDE_CODE_RELEASE_WORKFLOW.md.
GITHUB_REPO=aldbabiomar/vetclinicsystem
# The repository is private: each clinic's own read-only access token is set
# by the vendor in the Developer area (Updates), and kept in a file in the
# data folder -- never here.
# Only set these two once you've run `python3 setup.py --enable-updates`
# to switch this install onto the versioned-release layout (see
# UPDATE_MECHANISM_PLAN.md §3) — updates are disabled until both point at
# real folders outside this codebase.
#VETCLINICSYSTEM_DATA_DIR=
#VETCLINICSYSTEM_RELEASES_DIR=

# Request-connection pool sizing — sane defaults for a single-clinic LAN
# deployment, uncomment to override.
#DB_POOL_MIN_SIZE=2
#DB_POOL_MAX_SIZE=15
#DB_POOL_TIMEOUT_SECONDS=10
#DB_POOL_MAX_LIFETIME_SECONDS=1800

# Network/session hardening — all opt-in, inert unless set.
# Set this if a reverse proxy (nginx/Caddy/etc) is terminating TLS in
# front of this app. Leave unset for a plain-HTTP LAN deployment.
#BEHIND_TLS_PROXY=1
# How long a login session stays valid with no server-enforced expiry
# beyond this (hours).
#SESSION_LIFETIME_HOURS=12
# Comma-separated CIDR blocks allowed to reach this app at all, e.g.
# "192.168.1.0/24,10.0.0.5/32". Leave unset on a normal single-router
# clinic LAN.
#VETCLINICSYSTEM_ALLOWED_NETWORKS=
# Bind address/port. setup.py writes the port it chose on the first setup —
# 5050 unless something on this computer already has it — and the app, the
# launchers and the Desktop shortcut all read it from here.
#VETCLINICSYSTEM_HOST=0.0.0.0
#VETCLINICSYSTEM_PORT=5050
